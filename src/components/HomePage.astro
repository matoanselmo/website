---
import type { Lang } from "@/content/site";
import { CONTENT, SECTIONS } from "@/content/site";
import Layout from "@/layouts/Layout.astro";
import TopBar from "@/components/TopBar.astro";
import TuiPane from "@/components/TuiPane.astro";
import KeyHints from "@/components/KeyHints.astro";
import StatusDot from "@/components/StatusDot.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = CONTENT[lang];

const workspaces = [
  { id: "home", label: "~" },
  SECTIONS.about && { id: "about", label: t.about.label },
  SECTIONS.projects && { id: "projects", label: t.projects.label },
  SECTIONS.experience && { id: "experience", label: t.experience.label.split(" ")[0] },
].filter((w): w is { id: string; label: string } => Boolean(w));

const num = (id: string) => workspaces.findIndex((w) => w.id === id) + 1;
---

<Layout title={`${t.hero.name} | matoanselmo`} lang={lang}>
  <TopBar lang={lang} workspaces={workspaces} />

  <main class="main">
    <!-- HERO: name on the left, a small "now" pane floating beside it -->
    <section class="hero" id="home">
      <div class="hero__intro">
        <div class="hero__status">
          <StatusDot color="ok" />
          <span>{t.hero.status}</span>
        </div>
        <h1 class="hero__title">
          <span class="prompt">❯</span> {t.hero.name}<span class="cursor" />
        </h1>
        <p class="hero__role">{t.hero.role}</p>
        <p class="hero__tagline">{t.hero.tagline}</p>
      </div>

      {SECTIONS.now && (
        <div class="hero__now">
          <TuiPane title={t.now.label} focused>
            <p class="now__intro">{t.now.intro}</p>
            <ul class="now__list">
              {t.now.items.map((item) => (
                <li class="now__item"><span class="now__arrow">→</span><span>{item}</span></li>
              ))}
            </ul>
            <div class="now__updated">{t.now.updatedLabel} {t.now.updated}</div>
          </TuiPane>
        </div>
      )}
    </section>

    <!-- ABOUT -->
    {SECTIONS.about && (
      <section class="section" id="about">
        <h2 class="section__label"><span class="section__num">{num("about")}</span>{t.about.label}</h2>
        <div class="section__body">
          {t.about.body.map((para) => <p class="body-text">{para}</p>)}
        </div>
      </section>
    )}

    <!-- PROJECTS -->
    {SECTIONS.projects && (
      <section class="section" id="projects">
        <h2 class="section__label"><span class="section__num">{num("projects")}</span>{t.projects.label}</h2>
        <div class="section__body projects">
          {t.projects.items.map((p, i) => (
            <a
              href={p.repo}
              target="_blank"
              rel="noopener"
              class:list={["row", { "row--selected": i === 0 }]}
              data-row
            >
              <div class="row__top">
                <span class="row__name">{p.name}</span>
                <span class="row__meta">{p.meta}</span>
              </div>
              <p class="row__desc">{p.desc}</p>
              <span class="row__tags">{p.tags.map((tag) => <span>#{tag}</span>)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- EXPERIENCE -->
    {SECTIONS.experience && (
      <section class="section" id="experience">
        <h2 class="section__label"><span class="section__num">{num("experience")}</span>{t.experience.label}</h2>
        <ul class="section__body timeline">
          {t.experience.items.map((x) => (
            <li class="timeline__item">
              <span class="timeline__period">{x.period}</span>
              <div class="timeline__role">{x.role} <span class="text-faint">@</span> <span class="timeline__org">{x.org}</span></div>
              <p class="timeline__desc">{x.desc}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- FOOTER -->
    <footer class="footer">
      <KeyHints hints={t.ui.hints} />
      <span class="text-faint">{t.footer.note}</span>
    </footer>
  </main>
</Layout>

<script>
  // Tessera-style keys: 1-4 jump between sections, j/k move through the
  // project rows, enter opens the selected one, l switches language.
  const rows = [...document.querySelectorAll<HTMLAnchorElement>("[data-row]")];
  const workspaces = [...document.querySelectorAll<HTMLAnchorElement>("[data-ws]")];
  let selected = 0;

  const select = (i: number) => {
    selected = (i + rows.length) % rows.length;
    rows.forEach((r, n) => r.classList.toggle("row--selected", n === selected));
  };

  rows.forEach((r, i) => r.addEventListener("mouseenter", () => select(i)));

  document.addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const target = e.target as HTMLElement;
    if (target.matches("input, textarea")) return;

    const n = Number(e.key);
    if (n >= 1 && n <= workspaces.length) {
      workspaces[n - 1].click();
    } else if (e.key === "j" && rows.length) {
      select(selected + 1);
      rows[selected].scrollIntoView({ block: "nearest" });
    } else if (e.key === "k" && rows.length) {
      select(selected - 1);
      rows[selected].scrollIntoView({ block: "nearest" });
    } else if (e.key === "Enter" && rows.length && target === document.body) {
      window.open(rows[selected].href, "_blank", "noopener");
    } else if (e.key === "l") {
      document.querySelector<HTMLAnchorElement>("[data-lang]")?.click();
    }
  });
</script>

<style>
  .main {
    max-width: 1120px;
    padding: 0 clamp(16px, 6vw, 96px) var(--space-12);
  }

  .text-faint {
    color: var(--text-3);
  }

  /* Hero */
  .hero {
    min-height: calc(100vh - 35px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-16) 0;
    scroll-margin-top: 35px;
  }

  .hero__status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent-green);
    margin-bottom: var(--space-8);
  }

  .hero__title {
    font-size: clamp(36px, 8vw, 76px);
    line-height: 1;
    margin-bottom: var(--space-6);
  }

  .prompt {
    color: var(--accent-blue);
  }

  .cursor {
    display: inline-block;
    width: 0.5em;
    height: 0.85em;
    transform: translateY(0.08em);
    margin-left: 0.15em;
    background: var(--accent-blue);
    animation: mato-blink 1.1s steps(1) infinite;
  }

  .hero__role {
    font-size: var(--text-lg);
    color: var(--accent-violet);
    margin-bottom: var(--space-3);
  }

  .hero__tagline {
    font-size: var(--text-md);
    color: var(--text-2);
    max-width: 48ch;
  }

  .hero__now {
    animation: float-in 600ms var(--ease-out, ease-out) both 150ms;
  }

  @keyframes float-in {
    from { opacity: 0; transform: translateY(12px); }
  }

  /* Sections: a sticky label in the gutter, content flowing beside it */
  .section {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-8);
    padding: var(--space-16) 0;
    border-top: 1px solid var(--surface-raised);
    scroll-margin-top: 35px;
  }

  .section__label {
    position: sticky;
    top: 64px;
    align-self: start;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--text-2);
    letter-spacing: 0;
  }

  .section__num {
    display: inline-block;
    min-width: 1.6em;
    margin-right: var(--space-2);
    padding: 0 4px;
    background: var(--accent-blue);
    color: var(--bg);
    text-align: center;
  }

  .section__body {
    max-width: 64ch;
  }

  .body-text {
    font-size: var(--text-md);
    color: var(--text);
    line-height: 1.75;
  }

  .body-text + .body-text {
    margin-top: var(--space-4);
  }

  /* Projects: rows that light up like Tessera's selected table row */
  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 72ch;
  }

  .row {
    display: block;
    padding: var(--space-4);
    margin-left: calc(-1 * var(--space-4));
    color: var(--text);
    border-left: 2px solid transparent;
    transition: background var(--transition), border-color var(--transition);
  }

  .row:hover {
    opacity: 1;
  }

  .row__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .row__name {
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
    color: var(--accent-blue);
  }

  .row__meta {
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .row__desc {
    font-size: var(--text-sm);
    margin-bottom: var(--space-2);
  }

  .row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    font-size: var(--text-xs);
    color: var(--accent-cyan);
  }

  .row--selected {
    background: var(--surface-raised);
    border-left-color: var(--accent-blue);
  }

  /* Experience */
  .timeline {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .timeline__period {
    display: block;
    font-size: var(--text-xs);
    color: var(--accent-amber);
    margin-bottom: var(--space-1);
  }

  .timeline__role {
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
  }

  .timeline__org {
    color: var(--accent-cyan);
  }

  .timeline__desc {
    font-size: var(--text-sm);
    margin-top: var(--space-1);
  }

  /* Now pane */
  .now__intro {
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }

  .now__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .now__item {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text);
  }

  .now__arrow {
    color: var(--accent-green);
  }

  .now__updated {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* Footer */
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-sm);
    padding-top: var(--space-6);
    border-top: 1px solid var(--surface-raised);
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: var(--space-8);
    }

    .section {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding: var(--space-12) 0;
    }

    .section__label {
      position: static;
    }
  }
</style>
