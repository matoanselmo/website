---
import type { Lang } from "@/content/site";
import { CONTENT, SECTIONS } from "@/content/site";
import Layout from "@/layouts/Layout.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = CONTENT[lang];

// Education, competitions and clubs share one section, each as its own group.
const timelines = [
  SECTIONS.experience && t.experience,
  SECTIONS.competitions && t.competitions,
  SECTIONS.clubs && t.clubs,
].filter((g) => g !== false);

// Sections in the right column, numbered in the order they appear.
const sections = [
  SECTIONS.about && { id: "about", label: t.about.label },
  SECTIONS.projects && { id: "projects", label: t.projects.label },
  timelines.length > 0 && { id: "work", label: t.background.label },
]
  .filter((s): s is { id: string; label: string } => Boolean(s))
  .map((s, i) => ({ ...s, num: String(i + 1).padStart(2, "0") }));

const num = (id: string) => sections.find((s) => s.id === id)?.num;
---

<Layout title={`${t.hero.name} | matoanselmo`} lang={lang}>
  <div class="layout">
    <!-- Left column: pinned beside the content on wide screens -->
    <aside class="intro" id="home">
      <div class="hero">
        <h1 class="hero__name">
          {t.hero.name.split(" ").map((word, i, words) => (
            <>{word}{i < words.length - 1 && <br />}</>
          ))}<span class="cursor" aria-hidden="true" />
        </h1>
        <p class="hero__role">{t.hero.role}</p>
        <p class="hero__tagline">{t.hero.tagline}</p>
      </div>

      <nav class="toc" aria-label="On this page">
        {sections.map((s, i) => (
          <a class:list={["toc__link", { "is-active": i === 0 }]} href={`#${s.id}`} data-toc={s.id}>
            <span class="toc__rule" />
            {s.label}
          </a>
        ))}
      </nav>

      {SECTIONS.now && (
        <fieldset class="pane">
          <legend class="pane__title">{t.now.label}</legend>
          <ul class="now">
            {t.now.items.map((item) => (
              <li class="now__item"><span class="now__arrow">→</span>{item}</li>
            ))}
          </ul>
          <div class="now__updated">{t.now.updatedLabel} {t.now.updated}</div>
        </fieldset>
      )}

      <div class="links">
        <a class="tile" href={t.links.github} target="_blank" rel="noopener" aria-label="GitHub">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" /></svg>
        </a>
        <a class="tile" href={t.links.email} aria-label="Email">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" /><path d="m3 7 9 6 9-6" /></svg>
        </a>
        <span class="links__spacer" />
        <LanguageSwitcher current={lang} />
      </div>
    </aside>

    <!-- Right column: the part that scrolls -->
    <main class="content" id="content">
      {SECTIONS.about && (
        <section class="section" id="about">
          <h2 class="section__label"><span class="section__num">{num("about")}</span>{t.about.label}</h2>
          {t.about.body.map((para, i) => (
            <p class:list={["body-text", { "body-text--quiet": i > 0 }]}>{para}</p>
          ))}
        </section>
      )}

      {SECTIONS.projects && (
        <>
          <hr class="divider" aria-hidden="true" />
          <section class="section" id="projects">
            <h2 class="section__label"><span class="section__num">{num("projects")}</span>{t.projects.label}</h2>
            <div class="projects">
              {t.projects.items.map((p, i) => (
                <a class="proj" href={p.repo} target="_blank" rel="noopener">
                  <span class="proj__num">{String(i + 1).padStart(2, "0")}</span>
                  <span class="proj__body">
                    <span class="proj__name">{p.name}</span>
                    <span class="proj__desc">{p.desc}</span>
                    <span class="proj__tags">{p.tags.map((tag) => <span class="tag">{tag}</span>)}</span>
                  </span>
                  <span class="proj__arrow" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
            <a class="all-link" href={t.links.github} target="_blank" rel="noopener">{t.projects.allLabel} →</a>
          </section>
        </>
      )}

      {timelines.length > 0 && (
        <>
          <hr class="divider" aria-hidden="true" />
          <section class="section" id="work">
            <h2 class="section__label"><span class="section__num">{num("work")}</span>{t.background.label}</h2>
            {timelines.map((group) => (
              <div class="group">
                <h3 class="group__label">{group.label}</h3>
                {group.items.map((x) => (
                  <div class="job">
                    <span class="job__period">{x.period}</span>
                    <div class="job__body">
                      <span class="job__role">{x.role} <span class="text-faint">@</span> <span class="job__org">{x.org}</span></span>
                      <span class="job__desc">{x.desc}</span>
                    </div>
                  </div>
                ))}
              </div>
            ))}
          </section>
        </>
      )}

      <footer class="footer">{t.footer.note}</footer>
    </main>
  </div>
</Layout>

<script>
  const intro = document.getElementById("home");
  const content = document.getElementById("content");
  const links = [...document.querySelectorAll<HTMLElement>("[data-toc]")];
  const wide = window.matchMedia("(min-width: 960px)");

  // Start the right column level with the name in the centered left column,
  // so both sides share one top line on the first screen.
  const align = () => {
    const first = intro?.firstElementChild;
    if (!intro || !first || !content) return;
    content.style.paddingTop = wide.matches
      ? `${Math.max(48, Math.round(first.getBoundingClientRect().top - intro.getBoundingClientRect().top))}px`
      : "";
  };

  // The active section is the last one whose top has crossed 40% of the window.
  const spy = () => {
    const line = window.innerHeight * 0.4;
    let active = links[0]?.dataset.toc;
    for (const link of links) {
      const section = document.getElementById(link.dataset.toc!);
      if (section && section.getBoundingClientRect().top <= line) active = link.dataset.toc;
    }
    links.forEach((l) => l.classList.toggle("is-active", l.dataset.toc === active));
  };

  align();
  spy();
  window.addEventListener("resize", () => { align(); spy(); });
  window.addEventListener("scroll", spy, { passive: true });
</script>

<style>
  .layout {
    --gutter: clamp(20px, 5vw, 48px);
    max-width: 880px;
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 6vw, 48px);
  }

  .text-faint {
    color: var(--text-3);
  }

  /* Left column */
  .intro {
    --stack: clamp(28px, 2.5vw, 40px);
    padding: clamp(24px, 6vw, 64px) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--stack);
  }

  @media (min-width: 960px) {
    /* The panel runs from the window's left edge; the content keeps a readable width. */
    .layout {
      max-width: none;
      padding: 0;
      display: grid;
      /* 30% panel, 70% content; the panel never gets narrower than its contents need. */
      grid-template-columns: minmax(300px, 30fr) minmax(0, 70fr);
      gap: 0;
      /* One edge spacing on both sides of the panel border. */
      --edge: clamp(32px, 3vw, 48px);
    }

    /* The content fills its 75%; long text is still capped by .body-text. */
    .content {
      max-width: none;
      padding-inline: var(--edge);
    }

    .intro {
      position: sticky;
      top: 0;
      align-self: start;
      height: 100vh;
      height: 100dvh;
      padding: 48px var(--edge);
      /* safe: on short windows the panel scrolls instead of clipping its top */
      justify-content: safe center;
      overflow-y: auto;
      border-right: 1px solid var(--surface-raised);
      background-color: var(--surface-dim);
      background-image: radial-gradient(var(--dot) 1px, transparent 1.2px);
      background-size: 18px 18px;
      background-position: -1px -1px;
    }
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* A little more air under the name than between the lines below it. */
  .hero__name {
    margin-bottom: 8px;
  }

  .hero__name {
    font-size: clamp(40px, 2.4vw + 26px, 60px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .cursor {
    display: inline-block;
    width: 0.45em;
    height: 0.8em;
    margin-left: 0.12em;
    background: var(--accent-blue);
    animation: mato-blink 1.1s steps(1) infinite;
  }

  .hero__role {
    font-size: clamp(15px, 0.3vw + 13px, 18px);
    font-weight: var(--weight-medium);
    color: var(--accent-violet);
  }

  .hero__tagline {
    max-width: 34ch;
    font-size: clamp(14px, 0.2vw + 13px, 16px);
    color: var(--text-2);
  }

  /* Section nav */
  .toc {
    /* Cancel the links' own padding so the gaps above and below match the rest of the panel. */
    margin-block: -6px;
    display: flex;
    flex-direction: column;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .toc__link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 6px 0;
    color: var(--text-2);
    transition: color 0.25s ease;
  }

  .toc__rule {
    display: block;
    width: 32px;
    height: 1px;
    background: var(--rule);
    transition: width 0.25s ease, background 0.25s ease;
  }

  .toc__link:hover {
    opacity: 1;
    color: var(--text);
  }

  .toc__link:hover .toc__rule {
    width: 64px;
    background: var(--text);
  }

  .toc__link.is-active {
    color: var(--text);
  }

  .toc__link.is-active .toc__rule {
    width: 64px;
    background: var(--accent-blue);
  }

  /* Now pane, after Tessera's TuiPane */
  .pane {
    min-width: 0;
    padding: 8px 16px 16px;
    border: 1px solid var(--accent-blue);
    background: var(--surface);
  }

  .pane__title {
    padding: 0 6px;
    margin-left: -6px;
    font-weight: var(--weight-bold);
    color: var(--accent-blue);
  }

  .now {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
  }

  .now__item {
    display: flex;
    gap: 10px;
  }

  .now__arrow {
    color: var(--accent-green);
  }

  .now__updated {
    margin-top: 16px;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* Link tiles */
  .links {
    display: flex;
    gap: 4px;
  }

  .links__spacer {
    flex: 1;
  }

  .tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--surface);
    color: var(--text-2);
    transition: background var(--transition), color var(--transition);
  }

  .tile:hover {
    opacity: 1;
    background: var(--surface-overlay);
    color: var(--text);
  }

  /* Right column */
  .content {
    min-width: 0;
    padding-bottom: clamp(40px, 8vw, 64px);
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 48px);
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 24px;
    scroll-margin-top: 48px;
  }

  .section__label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-2);
  }

  .section__num {
    padding: 0 6px;
    background: var(--accent-blue);
    color: var(--bg);
  }

  .divider {
    border: 0;
    border-top: 1px dashed var(--surface-raised);
  }

  .body-text {
    max-width: 72ch;
    font-size: clamp(15px, 0.3vw + 13.5px, 17px);
    line-height: 1.7;
    color: var(--text);
  }

  .body-text--quiet {
    color: var(--text-2);
  }

  /* Projects: hovering one fades the rest */
  .projects {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0 calc(-1 * min(20px, var(--gutter, 20px)));
  }

  .proj {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: clamp(12px, 2vw, 20px);
    padding: clamp(14px, 2vw, 20px) min(20px, var(--gutter, 20px));
    color: var(--text);
    transition: background var(--transition), opacity var(--transition);
  }

  .proj:hover {
    opacity: 1;
    background: var(--surface);
  }

  .projects:hover .proj:not(:hover) {
    opacity: 0.5;
  }

  .proj__num {
    padding-top: 3px;
    font-size: var(--text-sm);
    color: var(--text-3);
  }

  .proj__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .proj__name {
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
    transition: color var(--transition);
  }

  .proj__desc {
    font-size: var(--text-base);
    color: var(--text-2);
  }

  .proj__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    font-size: var(--text-xs);
  }

  .tag {
    padding: 2px 8px;
    background: var(--surface-raised);
    color: var(--accent-cyan);
  }

  .proj__arrow {
    font-size: var(--text-md);
    color: var(--text-3);
    transition: color var(--transition), transform var(--transition);
  }

  .proj:hover .proj__name,
  .proj:hover .proj__arrow {
    color: var(--accent-blue);
  }

  .proj:hover .proj__arrow {
    transform: translate(2px, -2px);
  }

  .all-link {
    align-self: flex-start;
    font-size: 13px;
    font-weight: var(--weight-bold);
  }

  /* Experience: education, competitions, clubs */
  .group {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .group + .group {
    margin-top: 16px;
  }

  .group__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-3);
  }

  .job {
    display: grid;
    grid-template-columns: clamp(110px, 14vw, 140px) minmax(0, 1fr);
    gap: 4px 24px;
  }

  .job__period {
    padding-top: 3px;
    font-size: var(--text-sm);
    color: var(--accent-amber);
  }

  .job__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .job__role {
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
  }

  .job__org {
    color: var(--accent-cyan);
  }

  .job__desc {
    font-size: var(--text-base);
    color: var(--text-2);
  }

  .footer {
    padding-top: 24px;
    border-top: 1px dashed var(--surface-raised);
    font-size: var(--text-sm);
    color: var(--text-3);
  }

  @media (max-width: 959px) {
    /* Links and the language switch move to the top on narrow screens. */
    .links {
      order: -1;
    }
  }

  @media (max-width: 560px) {
    .job {
      grid-template-columns: 1fr;
    }
  }
</style>
