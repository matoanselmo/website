---
import type { Lang } from "@/content/site";
import { CONTENT, SECTIONS } from "@/content/site";
import Layout from "@/layouts/Layout.astro";
import TopBar from "@/components/TopBar.astro";
import TuiPane from "@/components/TuiPane.astro";
import KeyHints from "@/components/KeyHints.astro";
import StatusDot from "@/components/StatusDot.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = CONTENT[lang];

const workspaces = [
  { id: "home", label: "~" },
  SECTIONS.projects && { id: "projects", label: t.projects.label },
  SECTIONS.experience && { id: "experience", label: t.experience.label.split(" ")[0] },
  SECTIONS.now && { id: "now", label: t.now.label },
].filter((w): w is { id: string; label: string } => Boolean(w));
---

<Layout title={`${t.hero.name} | matoanselmo`} lang={lang}>
  <TopBar lang={lang} workspaces={workspaces} />

  <main class="main">
    <!-- HERO -->
    <TuiPane title="~/matoanselmo" id="home" focused>
      <div class="hero">
        <div class="hero__status">
          <StatusDot color="ok" />
          <span>{t.hero.status}</span>
        </div>
        <h1 class="hero__title">
          <span class="prompt">❯</span> {t.hero.name}<span class="cursor" />
        </h1>
        <p class="hero__role">{t.hero.role}</p>
        <p class="hero__tagline">{t.hero.tagline}</p>
      </div>
    </TuiPane>

    <!-- ABOUT -->
    {SECTIONS.about && (
      <TuiPane title={t.about.label} id="about">
        {t.about.body.map((para) => <p class="body-text">{para}</p>)}
      </TuiPane>
    )}

    <!-- PROJECTS -->
    {SECTIONS.projects && (
      <TuiPane title={t.projects.label} id="projects">
        <div class="table" role="list">
          <div class="table__head" aria-hidden="true">
            <span></span>{t.ui.columns.map((c) => <span>{c}</span>)}
          </div>
          {t.projects.items.map((p, i) => (
            <a
              href={p.repo}
              target="_blank"
              rel="noopener"
              role="listitem"
              class:list={["row", { "row--selected": i === 0 }]}
              data-row
            >
              <span class="row__mark">*</span>
              <span class="row__name">{p.name}</span>
              <span class="row__desc">
                {p.desc}
                <span class="row__tags">{p.tags.map((tag) => <span>#{tag}</span>)}</span>
              </span>
              <span class="row__meta">{p.meta}</span>
            </a>
          ))}
        </div>
      </TuiPane>
    )}

    <!-- EXPERIENCE -->
    {SECTIONS.experience && (
      <TuiPane title={t.experience.label} id="experience">
        <ul class="timeline">
          {t.experience.items.map((x) => (
            <li class="timeline__item">
              <span class="timeline__period">{x.period}</span>
              <div>
                <div class="timeline__role">{x.role} <span class="text-faint">@</span> <span class="timeline__org">{x.org}</span></div>
                <p class="timeline__desc">{x.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </TuiPane>
    )}

    <!-- NOW -->
    {SECTIONS.now && (
      <TuiPane title={t.now.label} id="now">
        <p class="now__intro">{t.now.intro}</p>
        <ul class="now__list">
          {t.now.items.map((item) => (
            <li class="now__item"><span class="now__arrow">→</span><span>{item}</span></li>
          ))}
        </ul>
        <div class="now__updated">{t.now.updatedLabel} {t.now.updated}</div>
      </TuiPane>
    )}

    <!-- FOOTER -->
    <footer class="footer">
      <KeyHints hints={t.ui.hints} />
      <span class="text-faint">{t.footer.note}</span>
    </footer>
  </main>
</Layout>

<script>
  // Tessera-style keys: 1-4 jump between sections, j/k move through the
  // project rows, enter opens the selected one, l switches language.
  const rows = [...document.querySelectorAll<HTMLAnchorElement>("[data-row]")];
  const workspaces = [...document.querySelectorAll<HTMLAnchorElement>("[data-ws]")];
  let selected = 0;

  const select = (i: number) => {
    selected = (i + rows.length) % rows.length;
    rows.forEach((r, n) => r.classList.toggle("row--selected", n === selected));
  };

  rows.forEach((r, i) => r.addEventListener("mouseenter", () => select(i)));

  document.addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const target = e.target as HTMLElement;
    if (target.matches("input, textarea")) return;

    const n = Number(e.key);
    if (n >= 1 && n <= workspaces.length) {
      workspaces[n - 1].click();
    } else if (e.key === "j" && rows.length) {
      select(selected + 1);
      rows[selected].scrollIntoView({ block: "nearest" });
    } else if (e.key === "k" && rows.length) {
      select(selected - 1);
      rows[selected].scrollIntoView({ block: "nearest" });
    } else if (e.key === "Enter" && rows.length && target === document.body) {
      window.open(rows[selected].href, "_blank", "noopener");
    } else if (e.key === "l") {
      document.querySelector<HTMLAnchorElement>("[data-lang]")?.click();
    }
  });
</script>

<style>
  .main {
    max-width: 860px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .text-faint {
    color: var(--text-3);
  }

  /* Hero */
  .hero {
    padding: var(--space-4) var(--space-2) var(--space-2);
  }

  .hero__status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent-green);
    margin-bottom: var(--space-6);
  }

  .hero__title {
    font-size: clamp(28px, 7vw, var(--text-2xl));
    margin-bottom: var(--space-4);
  }

  .prompt {
    color: var(--accent-blue);
  }

  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 0.92em;
    transform: translateY(0.08em);
    margin-left: 6px;
    background: var(--accent-blue);
    animation: mato-blink 1.1s steps(1) infinite;
  }

  .hero__role {
    font-size: var(--text-md);
    color: var(--accent-violet);
    margin-bottom: var(--space-2);
  }

  .hero__tagline {
    color: var(--text-2);
    max-width: 56ch;
  }

  .body-text {
    color: var(--text);
    max-width: 68ch;
  }

  .body-text + .body-text {
    margin-top: var(--space-3);
  }

  /* Projects table, after Tessera's TuiTable */
  .table__head,
  .row {
    display: grid;
    grid-template-columns: 2ch 14ch 1fr 10ch;
    gap: var(--space-3);
    padding: 4px var(--space-2);
  }

  .table__head {
    color: var(--text-2);
    font-weight: var(--weight-bold);
  }

  .row {
    color: var(--text);
    align-items: baseline;
  }

  .row:hover {
    opacity: 1;
  }

  .row__mark,
  .row__meta {
    color: var(--text-2);
  }

  .row__name {
    font-weight: var(--weight-bold);
    color: var(--accent-blue);
  }

  .row__desc {
    color: var(--text-2);
    font-size: var(--text-sm);
  }

  .row__tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    margin-left: var(--space-2);
    color: var(--accent-cyan);
  }

  .row--selected,
  .row--selected * {
    background: var(--accent-blue);
    color: var(--bg) !important;
  }

  @media (max-width: 640px) {
    .table__head {
      display: none;
    }

    .row {
      grid-template-columns: 2ch 1fr;
      row-gap: 2px;
      padding: var(--space-2);
    }

    .row__desc,
    .row__meta {
      grid-column: 2;
    }
  }

  /* Experience */
  .timeline {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 14ch 1fr;
    gap: var(--space-4);
  }

  .timeline__period {
    color: var(--accent-amber);
    font-size: var(--text-sm);
  }

  .timeline__role {
    font-weight: var(--weight-bold);
  }

  .timeline__org {
    color: var(--accent-cyan);
  }

  .timeline__desc {
    font-size: var(--text-sm);
    margin-top: 2px;
  }

  @media (max-width: 560px) {
    .timeline__item {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  /* Now */
  .now__intro {
    margin-bottom: var(--space-3);
  }

  .now__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .now__item {
    display: flex;
    gap: var(--space-3);
    color: var(--text);
  }

  .now__arrow {
    color: var(--accent-green);
  }

  .now__updated {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* Footer */
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-sm);
    padding: 0 var(--space-1);
  }
</style>
